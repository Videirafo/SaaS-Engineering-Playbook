{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Videirafo/SaaS-Engineering-Playbook/blob/main/templates/SEVEN_SYSTEMS_FLOW.schema.json",
  "title": "Seven Systems workflow adoption manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "project",
    "repository",
    "modules"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "rationale",
          "owner",
          "evidence"
        ],
        "properties": {
          "id": {
            "enum": [
              "01",
              "02",
              "03",
              "04",
              "05",
              "06",
              "07"
            ]
          },
          "status": {
            "enum": [
              "not_applicable",
              "planned",
              "partial",
              "verified"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "data_source": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "last_verified_sha": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "verified"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "evidence": {
                  "minItems": 1
                }
              },
              "required": [
                "last_verified_sha"
              ]
            }
          }
        ]
      }
    }
  }
}
